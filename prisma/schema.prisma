generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  KRW
  USD
  JPY
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

// 이 enum은 app/(protected)/my-plan/_lib/cost.ts의 CostCategory 유니온과 수기 복제 관계다
// (자동 파생 아님). 값을 고치면 그쪽 유니온·CATEGORIES·라벨·색 맵까지 같이 봐야 한다.
enum CostCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ENTRANCE
  ETC
  PARKING // 0564: 화면 순서는 CATEGORIES 배열이 정하므로 여기 위치는 무의미(맨 뒤 append)
}

enum MovieStatus {
  APPROVED
  PENDING
}

enum UserRole {
  USER
  ADMIN
}

// 0207: Spot 프로비넌스. 'seed'=시딩 촬영지(청소 보호)/'user'=사용자 생성. 0208 청소 로직 분기축
enum SpotSource {
  seed
  user
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  nickname  String   @db.VarChar(20) @map("nickname")
  createdAt DateTime @default(now()) @map("created_at")
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(USER)

  stories   Story[]
  myPlans   MyPlan[]
  likes     Like[]
  planLikes PlanLike[]

  @@map("users")
}

model Story {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  photoUrl  String?  @map("photo_url")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  planId    String?  @unique @map("plan_id")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       MyPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  tags       Tag[]
  spots      Spot[]
  storySpots StorySpot[]
  likes      Like[]

  @@map("stories")
  @@index([userId])
  @@index([createdAt])
}

model Spot {
  id          String   @id @default(cuid())
  storyId     String?  @map("story_id") // S1: 공유 준비로 nullable화. S4에서 story_spots로 대체·제거
  story       Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order       Int
  name        String
  description String?
  lat         Float
  lng         Float
  photoUrl    String?  @map("photo_url")
  coverUrl    String?  @map("cover_url") // 좌표 기반 촬영지 대표 커버 (KorService2 locationBasedList2). thumbnailUrl 폴백 소스
  review      String?  @map("review")
  address     String?  @map("address")
  movieId     String?  @map("movie_id")
  movie       Movie?   @relation(fields: [movieId], references: [id], onDelete: SetNull)
  nearestStation String? @map("nearest_station") // 교통 기준점 이름 ("강릉역"/"제주공항") — 수동 입력 v1
  transitMinutes Int?    @map("transit_minutes") // 기준점에서 소요 분 — 자동 계산은 시딩 후 별도
  transitMode    String? @map("transit_mode") // 'walk'|'car'. 거리 기반 판정으로 이름 파생 불가 → 저장(transit.ts 주석 예고 시점)
  source      SpotSource @default(user) // 0207: 프로비넌스. 청소/보호 분기(0208)의 단일 소스. 이번 커밋은 읽지 않음
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  storySpots  StorySpot[] // 스토리↔장소 (per-visit). S2 읽기 전환 대상
  spotMovies  SpotMovie[] // 장소↔작품 다대다. "이 장소의 작품 N편"
  planSpots   PlanSpot[]  // 0493: 플랜 항목↔스팟 역참조. Prisma 양방향 규칙상 필수, 가상 필드(DB 컬럼 없음)

  @@map("spots")
  @@index([storyId])
  @@index([storyId, order])
  @@index([movieId])
}

// S1 expand: 스토리↔장소 조인 (per-visit 기록: order/review/photoUrl 이관처)
model StorySpot {
  id        String   @id @default(cuid())
  storyId   String   @map("story_id")
  spotId    String   @map("spot_id")
  order     Int
  review    String?
  photoUrl  String?  @map("photo_url")
  rating    Int? // per-visit 별점 1~5 (B2). Spot의 ★는 이 값들의 평균(파생). 범위는 앱단 검증
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  spot  Spot  @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("story_spots")
  @@unique([storyId, spotId])
  @@index([storyId, order])
  @@index([spotId])
}

// S1 expand: 장소↔작품 다대다 조인
model SpotMovie {
  id        String   @id @default(cuid())
  spotId      String   @map("spot_id")
  movieId     String   @map("movie_id")
  description String?  // per-link 촬영 장면 설명 (RELATE_PLACE_DC). 같은 장소라도 작품마다 다름
  createdAt   DateTime @default(now()) @map("created_at")

  spot  Spot  @relation(fields: [spotId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("spot_movies")
  @@unique([spotId, movieId])
  @@index([movieId])
  @@index([spotId])
}

model Movie {
  id        String      @id @default(cuid())
  title     String
  status    MovieStatus @default(APPROVED)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  spots      Spot[]
  spotMovies SpotMovie[]

  @@map("movies")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  stories   Story[]

  @@map("tags")
}

model MyPlan {
  id            String    @id @default(cuid())
  ownerId       String    @map("owner_id") @db.Uuid
  sourceStoryId String?   @map("source_story_id")
  sourcePlanId  String?   @map("source_plan_id")
  title         String
  currency      Currency  @default(KRW)
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  description   String?
  region        String?
  movie         String?
  isPublic       Boolean   @default(false) @map("is_public")
  isDraft        Boolean   @default(false) @map("is_draft")
  sourceNickname String?   @db.VarChar(20) @map("source_nickname")
  // 0594: 담은 시점의 PlanCost 합계 스냅샷. 비용 주의 배너의 판정 기준 —
  //   "현재 합계와 다르면 담은 사람이 금액을 고친 것"으로 본다.
  //   NULL = 스냅샷 없음(담기가 아닌 플랜 / 0594 이전에 담긴 플랜). 0(합계 0원)과 다른 뜻이다.
  //   PlanFlight는 합산에서 제외 — 담기가 항공을 복사하지 않으므로(0580) 담은 시점 값이 늘 0이고,
  //   나중에 항공권을 붙이면 "비용을 안 고쳤는데" 총액이 바뀐다.
  sourceCostTotal Int?     @map("source_cost_total")
  headcount      Int       @default(1)
  coverUrl       String?   @map("cover_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  story     Story?
  spots     PlanSpot[]
  costs     PlanCost[]
  flight    PlanFlight?
  planLikes PlanLike[]

  @@map("my_plans")
  @@index([ownerId])
}

model PlanSpot {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  day       Int
  order     Int
  name      String
  lat       Float?   // 0493 3단계: nullable화 — place 없는 항목(이동 기록 등)은 좌표 부재(NULL)
  lng       Float?
  spotId    String?  @map("spot_id") // 0493: 검색-선택한 Spot FK. nullable(미등록 장소·이동 기록 허용)
  createdAt DateTime @default(now()) @map("created_at")

  plan  MyPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  spot  Spot?      @relation(fields: [spotId], references: [id], onDelete: SetNull) // 스팟 청소 시 항목은 name으로 잔존
  costs PlanCost[]

  @@map("plan_spots")
  @@index([planId])
  @@index([planId, day, order])
  @@index([spotId])
}

model PlanCost {
  id         String       @id @default(cuid())
  planId     String       @map("plan_id")
  planSpotId String?      @map("plan_spot_id")
  day        Int?         // 0504: nullable화 — 하루에 안 묶이는 비용(렌터카·항공권·보험 등)은 day 부재(NULL)
  // 0588: 표시 순서의 정본. 순번 공간은 (planId, day) 그룹별 — day=null인 고정 비용이 한 그룹.
  //   createdAt(삽입 순서)에 기대던 정렬을 대체한다: 드래그로 순서를 바꾸면 둘이 갈린다.
  //   PlanSpot.order와 같은 축이지만 그쪽은 (planId, day, order)에 day가 NOT NULL이라 짝이 아니다.
  order      Int
  category   CostCategory
  label      String
  amount     Int
  createdAt  DateTime     @default(now()) @map("created_at")

  plan      MyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planSpot  PlanSpot? @relation(fields: [planSpotId], references: [id], onDelete: SetNull)

  @@map("plan_costs")
  @@index([planId])
  @@index([planId, day])
  @@index([planId, day, order]) // 0588: 그룹 안 정렬 조회용 (PlanSpot의 같은 형태 인덱스와 대응)
}

model PlanFlight {
  id          String   @id @default(cuid())
  planId      String   @unique @map("plan_id")
  tripType    TripType @map("trip_type")
  totalAmount Int      @map("total_amount")       // 원(KRW 고정)

  outOrigin      String   @map("out_origin")      @db.Char(3)
  outDestination String   @map("out_destination") @db.Char(3)
  outDepartsAt   DateTime @map("out_departs_at")  @db.Timestamptz(3)
  outArrivesAt   DateTime @map("out_arrives_at")  @db.Timestamptz(3)
  outAirline     String   @map("out_airline")
  outFlightNo    String   @map("out_flight_no")

  retOrigin      String?   @map("ret_origin")      @db.Char(3)
  retDestination String?   @map("ret_destination") @db.Char(3)
  retDepartsAt   DateTime? @map("ret_departs_at")  @db.Timestamptz(3)
  retArrivesAt   DateTime? @map("ret_arrives_at")  @db.Timestamptz(3)
  retAirline     String?   @map("ret_airline")
  retFlightNo    String?   @map("ret_flight_no")

  createdAt DateTime @default(now()) @map("created_at")

  plan MyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_flights")
}

model Like {
  id        String   @id @default(cuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("likes")
  @@unique([storyId, userId])
}

model PlanLike {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  plan      MyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plan_likes")
  @@unique([planId, userId])
}
