generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  KRW
  USD
  JPY
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum CostCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ENTRANCE
  ETC
}

enum MovieStatus {
  APPROVED
  PENDING
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  nickname  String   @db.VarChar(20) @map("nickname")
  createdAt DateTime @default(now()) @map("created_at")
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(USER)

  stories   Story[]
  myPlans   MyPlan[]
  likes     Like[]
  planLikes PlanLike[]

  @@map("users")
}

model Story {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  photoUrl  String?  @map("photo_url")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  planId    String?  @unique @map("plan_id")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      MyPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  tags      Tag[]
  spots     Spot[]
  likes     Like[]

  @@map("stories")
  @@index([userId])
  @@index([createdAt])
}

model Spot {
  id          String   @id @default(cuid())
  storyId     String   @map("story_id")
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order       Int
  name        String
  description String?
  lat         Float
  lng         Float
  photoUrl    String?  @map("photo_url")
  review      String?  @map("review")
  address     String?  @map("address")
  movieId     String?  @map("movie_id")
  movie       Movie?   @relation(fields: [movieId], references: [id], onDelete: SetNull)
  nearestStation String? @map("nearest_station") // 교통 기준점 이름 ("강릉역"/"제주공항") — 수동 입력 v1
  transitMinutes Int?    @map("transit_minutes") // 기준점에서 소요 분 — 자동 계산은 시딩 후 별도
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("spots")
  @@index([storyId])
  @@index([storyId, order])
  @@index([movieId])
}

model Movie {
  id        String      @id @default(cuid())
  title     String
  status    MovieStatus @default(APPROVED)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  spots     Spot[]

  @@map("movies")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  stories   Story[]

  @@map("tags")
}

model MyPlan {
  id            String    @id @default(cuid())
  ownerId       String    @map("owner_id") @db.Uuid
  sourceStoryId String?   @map("source_story_id")
  sourcePlanId  String?   @map("source_plan_id")
  title         String
  currency      Currency  @default(KRW)
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  description   String?
  region        String?
  movie         String?
  isPublic       Boolean   @default(false) @map("is_public")
  isDraft        Boolean   @default(false) @map("is_draft")
  sourceNickname String?   @db.VarChar(20) @map("source_nickname")
  createdAt      DateTime  @default(now()) @map("created_at")

  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  story     Story?
  spots     PlanSpot[]
  costs     PlanCost[]
  flight    PlanFlight?
  planLikes PlanLike[]

  @@map("my_plans")
  @@index([ownerId])
}

model PlanSpot {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  day       Int
  order     Int
  name      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")

  plan  MyPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  costs PlanCost[]

  @@map("plan_spots")
  @@index([planId])
  @@index([planId, day, order])
}

model PlanCost {
  id         String       @id @default(cuid())
  planId     String       @map("plan_id")
  planSpotId String?      @map("plan_spot_id")
  day        Int
  category   CostCategory
  label      String
  amount     Int
  createdAt  DateTime     @default(now()) @map("created_at")

  plan      MyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planSpot  PlanSpot? @relation(fields: [planSpotId], references: [id], onDelete: SetNull)

  @@map("plan_costs")
  @@index([planId])
  @@index([planId, day])
}

model PlanFlight {
  id          String   @id @default(cuid())
  planId      String   @unique @map("plan_id")
  tripType    TripType @map("trip_type")
  totalAmount Int      @map("total_amount")       // 원(KRW 고정)

  outOrigin      String   @map("out_origin")      @db.Char(3)
  outDestination String   @map("out_destination") @db.Char(3)
  outDepartsAt   DateTime @map("out_departs_at")  @db.Timestamptz(3)
  outArrivesAt   DateTime @map("out_arrives_at")  @db.Timestamptz(3)
  outAirline     String   @map("out_airline")
  outFlightNo    String   @map("out_flight_no")

  retOrigin      String?   @map("ret_origin")      @db.Char(3)
  retDestination String?   @map("ret_destination") @db.Char(3)
  retDepartsAt   DateTime? @map("ret_departs_at")  @db.Timestamptz(3)
  retArrivesAt   DateTime? @map("ret_arrives_at")  @db.Timestamptz(3)
  retAirline     String?   @map("ret_airline")
  retFlightNo    String?   @map("ret_flight_no")

  createdAt DateTime @default(now()) @map("created_at")

  plan MyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_flights")
}

model Like {
  id        String   @id @default(cuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("likes")
  @@unique([storyId, userId])
}

model PlanLike {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  plan      MyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plan_likes")
  @@unique([planId, userId])
}
