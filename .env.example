# Supabase
# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — 서버 전용. auth.admin API(회원 탈퇴 등)에서만 사용.
# NEXT_PUBLIC_ 접두어 절대 금지 — 클라 번들에 노출되면 계정 삭제 권한 유출.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma + Supabase PostgreSQL
# Supabase 대시보드 > Project Settings > Database > Connection string
# region 예시: ap-northeast-2 (Seoul), ap-northeast-1 (Tokyo)

# DATABASE_URL: "Transaction" 모드 (pgbouncer, port 6543)
#   → 일반 쿼리용. 커넥션 풀링 적용됨.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL: "Session" 모드 (direct, port 5432)
#   → prisma migrate 전용. pgbouncer 우회 필요.
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
